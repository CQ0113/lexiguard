rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    match /vault/{ownerUserId}/{docId}/{fileName=**} {
      allow read: if isSignedIn() && (
        request.auth.uid == ownerUserId ||
        request.auth.uid in firestore.get(/databases/(default)/documents/vault_documents/$(docId)).data.allowedUserIds
      );
      allow write: if isSignedIn() &&
        request.auth.uid == ownerUserId;
    }

    match /case_attachments/{clientUserId}/{caseId}/{fileName=**} {
      allow read: if isSignedIn() && (
        request.auth.uid == clientUserId ||
        request.auth.uid == firestore.get(/databases/(default)/documents/cases/$(caseId)).data.lawyerId ||
        (firestore.get(/databases/(default)/documents/cases/$(caseId)).data.status == 'pending' &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.verificationStatus == 'auto_verified')
      );
      allow write: if isSignedIn() &&
        request.auth.uid == clientUserId;
    }

    match /chat_attachments/{roomId}/{fileName} {
      allow read: if isSignedIn()
          && request.auth.uid in firestore.get(/databases/(default)/documents/chat_rooms/$(roomId)).data.participants;
      allow write: if isSignedIn()
          && request.auth.uid in firestore.get(/databases/(default)/documents/chat_rooms/$(roomId)).data.participants
          && request.resource.size <= 10 * 1024 * 1024
          && (request.resource.contentType.matches('image/.*')
              || request.resource.contentType.matches('application/pdf')
              || request.resource.contentType.matches('application/vnd\\.openxmlformats.*')
              || request.resource.contentType.matches('application/msword')
              || request.resource.contentType.matches('text/plain'));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
