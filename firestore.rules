rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isReviewer() {
      return isSignedIn() && request.auth.token.reviewer == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin123@gmail.com';
    }

    function isVerifiedLawyer() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        ('verificationStatus' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'auto_verified';
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isReviewer() || isAdmin() ||
          (isSignedIn() &&
            resource.data.role == 'lawyer' &&
            resource.data.verificationStatus == 'auto_verified');
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isReviewer() || isAdmin();
      allow delete: if false;
    }

    match /lawyer_profiles/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) || isReviewer();
      allow update: if isOwner(uid) || isReviewer();
      allow delete: if false;
    }

    match /verification_requests/{uid} {
      allow create: if isOwner(uid);
      allow read: if isOwner(uid) || isReviewer();
      allow update: if isReviewer();
      allow delete: if false;
    }

    match /cases/{caseId} {
      allow read: if isSignedIn() && (
          ('clientId' in resource.data && resource.data.clientId == request.auth.uid) ||
          ('lawyerId' in resource.data && resource.data.lawyerId == request.auth.uid) ||
          (isVerifiedLawyer() && 'status' in resource.data && resource.data.status == 'pending')
      );

      allow create: if isSignedIn() &&
          request.resource.data.clientId == request.auth.uid &&
          request.resource.data.title is string &&
          request.resource.data.description is string &&
          request.resource.data.category is string &&
          request.resource.data.status is string &&
          request.resource.data.status in ['pending', 'active', 'closed', 'withdrawn'] &&
          request.resource.data.urgency is string &&
          request.resource.data.progressPercent is number &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.interestedLawyerIds is list &&
          (!('lawyerId' in request.resource.data) ||
              request.resource.data.lawyerId == null ||
              request.resource.data.lawyerId is string) &&
          (!('nextHearing' in request.resource.data) ||
              request.resource.data.nextHearing == null ||
              request.resource.data.nextHearing is timestamp);

      allow update: if isSignedIn() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['clientId', 'createdAt']) && (
            // Original: case owner or assigned lawyer may update freely
            ((resource.data.clientId == request.auth.uid ||
              resource.data.lawyerId == request.auth.uid) &&
              request.resource.data.status == resource.data.status) ||
            // Verified lawyer appending self to interestedLawyerIds (EOI send)
            (isVerifiedLawyer() &&
                resource.data.lawyerId == null &&
                request.resource.data.interestedLawyerIds.hasAll(resource.data.interestedLawyerIds) &&
              request.resource.data.interestedLawyerIds.size() == resource.data.interestedLawyerIds.size() + 1 &&
              request.resource.data.status == resource.data.status) ||
            // Verified lawyer withdrawing EOI (removing self from list)
            (isVerifiedLawyer() &&
                resource.data.lawyerId == null &&
                resource.data.interestedLawyerIds.hasAll(request.resource.data.interestedLawyerIds) &&
                request.resource.data.interestedLawyerIds.size() == resource.data.interestedLawyerIds.size() - 1 &&
              !request.resource.data.interestedLawyerIds.hasAny([request.auth.uid]) &&
              request.resource.data.status == resource.data.status) ||
            // Client setting lawyerId on their own case (approve connection)
            (resource.data.clientId == request.auth.uid &&
                resource.data.lawyerId == null &&
              request.resource.data.lawyerId is string &&
              request.resource.data.status == 'active') ||
            // Requested lawyer accepting a client-initiated recommendation request
            (isVerifiedLawyer() &&
                resource.data.status == 'pending' &&
                resource.data.lawyerId == null &&
                request.resource.data.lawyerId == request.auth.uid &&
                request.resource.data.status == 'active' &&
                exists(/databases/$(database)/documents/connection_requests/$(caseId + '_' + request.auth.uid)) &&
                get(/databases/$(database)/documents/connection_requests/$(caseId + '_' + request.auth.uid)).data.status == 'pending' &&
                get(/databases/$(database)/documents/connection_requests/$(caseId + '_' + request.auth.uid)).data.initiatedByRole == 'client')
          );

      allow delete: if false;
    }

    match /connection_requests/{reqId} {
      allow create: if isSignedIn() && (
        // Lawyer expression of interest
        (request.auth.uid == request.resource.data.lawyerId
          && isVerifiedLawyer()
          && request.resource.data.status == 'pending'
          && reqId == request.resource.data.caseId + '_' + request.auth.uid
          && request.resource.data.caseId is string
          && request.resource.data.clientId is string
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 50
          && request.resource.data.message.size() <= 500
          && request.resource.data.lawyerSnapshot is map
          && request.resource.data.initiatedByRole == 'lawyer'
          && request.resource.data.requestDirection == 'lawyer_to_client') ||
        // Client request to a recommended lawyer
        (request.auth.uid == request.resource.data.clientId
          && request.resource.data.status == 'pending'
          && reqId == request.resource.data.caseId + '_' + request.resource.data.lawyerId
          && request.resource.data.caseId is string
          && request.resource.data.clientId is string
          && request.resource.data.lawyerId is string
          && request.resource.data.message is string
          && request.resource.data.lawyerSnapshot is map
          && request.resource.data.caseSnapshot is map
          && (!('clientReveal' in request.resource.data) ||
              (request.resource.data.clientReveal is map &&
               request.resource.data.clientReveal.name is string))
          && request.resource.data.initiatedByRole == 'client'
          && request.resource.data.requestDirection == 'client_to_lawyer'
          && get(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.clientId == request.auth.uid
          && get(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.status == 'pending')
      );

      allow get: if isSignedIn() && (
        resource == null ||
        (resource != null && 'clientId' in resource.data && request.auth.uid == resource.data.clientId) ||
        (resource != null && 'lawyerId' in resource.data && request.auth.uid == resource.data.lawyerId)
      );
      
      allow list: if isSignedIn() && (
        ('clientId' in resource.data && request.auth.uid == resource.data.clientId) ||
        ('lawyerId' in resource.data && request.auth.uid == resource.data.lawyerId) ||
        (isVerifiedLawyer() && resource.data.status == 'pending')
      );

      allow update: if isSignedIn() && (
        // Client approves
        (request.auth.uid == resource.data.clientId
          && resource.data.status == 'pending'
          && request.resource.data.status == 'approved'
          && request.resource.data.clientReveal is map
          && (!('initiatedByRole' in resource.data) || resource.data.initiatedByRole == 'lawyer')) ||
        // Client declines
        (request.auth.uid == resource.data.clientId
          && resource.data.status == 'pending'
          && request.resource.data.status == 'declined'
          && (!('initiatedByRole' in resource.data) || resource.data.initiatedByRole == 'lawyer')) ||
        // Lawyer withdraws
        (request.auth.uid == resource.data.lawyerId
          && resource.data.status == 'pending'
          && request.resource.data.status == 'withdrawn'
          && (!('initiatedByRole' in resource.data) || resource.data.initiatedByRole == 'lawyer')) ||
        // Lawyer re-sends after withdraw/expire (resets to pending from withdrawn or expired)
        (request.auth.uid == resource.data.lawyerId
          && resource.data.lawyerId == request.resource.data.lawyerId
          && resource.data.status in ['withdrawn', 'expired']
          && request.resource.data.status == 'pending'
          && isVerifiedLawyer()
          && request.resource.data.initiatedByRole == 'lawyer') ||
        // Requested lawyer accepts client-initiated request
        (request.auth.uid == resource.data.lawyerId
          && resource.data.status == 'pending'
          && resource.data.initiatedByRole == 'client'
          && request.resource.data.status == 'approved') ||
        // Requested lawyer declines client-initiated request
        (request.auth.uid == resource.data.lawyerId
          && resource.data.status == 'pending'
          && resource.data.initiatedByRole == 'client'
          && request.resource.data.status == 'declined') ||
        // Client re-sends a previously terminal client-initiated request
        (request.auth.uid == resource.data.clientId
          && resource.data.initiatedByRole == 'client'
          && resource.data.status in ['declined', 'withdrawn', 'expired']
          && request.resource.data.status == 'pending'
          && request.resource.data.initiatedByRole == 'client'
          && request.resource.data.requestDirection == 'client_to_lawyer'
          && request.resource.data.clientId == resource.data.clientId
          && request.resource.data.lawyerId == resource.data.lawyerId
          && request.resource.data.caseId == resource.data.caseId) ||
        // System auto-expire: client flips sibling pending requests to expired
        // when a client approves one request, the client also writes 'expired' to siblings
        (request.auth.uid == resource.data.clientId
          && resource.data.status == 'pending'
          && request.resource.data.status == 'expired') ||
        // Requested lawyer expires sibling pending requests after accepting a case
        (isVerifiedLawyer()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'expired'
          && getAfter(/databases/$(database)/documents/cases/$(resource.data.caseId)).data.status == 'active'
          && getAfter(/databases/$(database)/documents/cases/$(resource.data.caseId)).data.lawyerId == request.auth.uid) ||
        // Client repairs denormalized reveal data for an already-approved
        // connection. This is limited to display/contact reveal fields.
        (request.auth.uid == resource.data.clientId
          && resource.data.status == 'approved'
          && request.resource.data.status == resource.data.status
          && request.resource.data.clientId == resource.data.clientId
          && request.resource.data.lawyerId == resource.data.lawyerId
          && request.resource.data.caseId == resource.data.caseId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientReveal', 'updatedAt'])
          && request.resource.data.clientReveal is map
          && request.resource.data.clientReveal.name is string)
      );

      allow delete: if false;
    }

    match /cases/{caseId}/history/{historyId} {
      allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/cases/$(caseId)).data.clientId == request.auth.uid ||
            get(/databases/$(database)/documents/cases/$(caseId)).data.lawyerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read, list: if isSignedIn() &&
          request.auth.uid == resource.data.userId;
      allow update: if isSignedIn() &&
          request.auth.uid == resource.data.userId &&
          request.resource.data.userId == resource.data.userId;
      allow create, delete: if false;
    }

    match /vault_documents/{docId} {
      allow read: if isSignedIn() && (
          resource.data.ownerUserId == request.auth.uid ||
          request.auth.uid in resource.data.allowedUserIds
      );

      allow create: if isSignedIn() &&
          request.resource.data.ownerUserId == request.auth.uid &&
          request.resource.data.fileName is string &&
          request.resource.data.downloadUrl is string &&
          request.resource.data.storagePath is string &&
          request.resource.data.allowedUserIds is list &&
          request.auth.uid in request.resource.data.allowedUserIds;

      allow update: if isSignedIn() && (
          (resource.data.ownerUserId == request.auth.uid &&
              request.resource.data.ownerUserId == resource.data.ownerUserId) ||
          (resource.data.isContract == true &&
              request.auth.uid in resource.data.allowedUserIds &&
              request.resource.data.contractStatus == 'signed')
      );

      allow delete: if isSignedIn() &&
          resource.data.ownerUserId == request.auth.uid;
    }

    match /chat_rooms/{roomId} {
      // get: resource is available — check participants directly.
      // list: resource is null for queries; allow authenticated users to query.
      //   Security comes from the arrayContains filter: only rooms where the
      //   caller is a participant are returned, and each returned doc satisfies
      //   the get rule.
      // resource == null when the doc doesn't exist; allow the get so callers
      // can check existence before creating (e.g. ensureRoom in ChatRepository).
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isSignedIn();

      // Created atomically inside ConnectionRequestRepository.approveRequest.
      // Rules evaluate against the pre-transaction committed state, so the
      // connection_requests doc status is still 'pending' at create time —
      // checking for 'approved' here would always deny. Instead we verify
      // (a) the caller is listed in the new room's participants array, and
      // (b) a matching connection_requests doc actually exists, and
      // (c) the caller is one of the two parties on that connection request.
      // This prevents anyone outside the legitimate pair from creating a room.
      allow create: if request.auth.uid in request.resource.data.participants
                    && exists(/databases/$(database)/documents/connection_requests/$(roomId))
                    && (request.auth.uid == get(/databases/$(database)/documents/connection_requests/$(roomId)).data.clientId
                        || request.auth.uid == get(/databases/$(database)/documents/connection_requests/$(roomId)).data.lawyerId);

      // Only mutable fields may change. Three permitted paths:
      //   1. Send a message: lastSenderId == caller (updates last-message fields + bumps unreadCounts).
      //   2. Mark read: caller zeroes their own unread slot only.
      //   3. Client repairs their denormalized display name.
      allow update: if request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants
                    && request.resource.data.caseId == resource.data.caseId
                    && request.resource.data.clientId == resource.data.clientId
                    && request.resource.data.lawyerId == resource.data.lawyerId
                    && (
                         (
                           request.resource.data.diff(resource.data).changedKeys().hasOnly(
                            ['lastMessageText','lastMessageType','lastSenderId','lastMessageAt','unreadCounts'])
                           && (
                              request.resource.data.lastSenderId == request.auth.uid
                              || request.resource.data.unreadCounts[request.auth.uid] == 0
                            )
                         ) ||
                         (
                           request.auth.uid == resource.data.clientId
                           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientName'])
                           && request.resource.data.clientName is string
                         )
                       );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants;

        // Validated create: caller must be senderId, must be a room participant,
        // senderRole must match their role on the room, type must be valid,
        // text messages bounded 1–4000 chars, non-text messages require attachment fields.
        allow create: if request.auth.uid == request.resource.data.senderId
                      && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants
                      && request.resource.data.type in ['text', 'image', 'file']
                      && request.resource.data.senderRole in ['client', 'lawyer']
                      && (request.resource.data.senderRole == 'client'
                            ? request.auth.uid == get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.clientId
                            : request.auth.uid == get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.lawyerId)
                      && (request.resource.data.type != 'text'
                            || (request.resource.data.text is string
                                && request.resource.data.text.size() > 0
                                && request.resource.data.text.size() <= 4000))
                      && (request.resource.data.type == 'text'
                            || (request.resource.data.attachmentStoragePath is string
                                && request.resource.data.attachmentName is string));

        // Support message editing and deleting by the original sender.
        allow update: if request.auth.uid == resource.data.senderId
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.roomId == resource.data.roomId
                      && request.resource.data.type == resource.data.type
                      && (!('expiresAt' in resource.data) || request.resource.data.expiresAt == resource.data.expiresAt)
                      && (request.resource.data.text is string
                          && request.resource.data.text.size() > 0
                          && request.resource.data.text.size() <= 4000);
        allow delete: if request.auth.uid == resource.data.senderId;
      }
    }

    match /lexibot_config/{configId} {
      allow read: if isSignedIn();
      allow write: if false; // Admin SDK only
    }

    match /legal_sources/{sourceId} {
      allow read: if isSignedIn();
      allow write: if false; // Admin SDK only

      match /versions/{versionId} {
        allow read: if isSignedIn();
        allow write: if false; // Admin SDK only
      }
    }

    match /lexibot_audit_logs/{logId} {
      allow read, write: if false; // Admin SDK only
    }

    match /users/{uid}/lexibot_conversations/{conversationId} {
      allow read, write: if isOwner(uid);

      match /messages/{messageId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /law_corpus/{chunkId} {
      allow read, write: if false; // Admin SDK only.
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
