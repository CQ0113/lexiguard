rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isReviewer() {
      return isSignedIn() && request.auth.token.reviewer == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isReviewer();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isReviewer();
      allow delete: if false;
    }

    match /lawyer_profiles/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) || isReviewer();
      allow update: if isOwner(uid) || isReviewer();
      allow delete: if false;
    }

    match /verification_requests/{uid} {
      allow create: if isOwner(uid);
      allow read: if isOwner(uid) || isReviewer();
      allow update: if isReviewer();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
