rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isReviewer() {
      return isSignedIn() && request.auth.token.reviewer == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isReviewer();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isReviewer();
      allow delete: if false;
    }

    match /lawyer_profiles/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) || isReviewer();
      allow update: if isOwner(uid) || isReviewer();
      allow delete: if false;
    }

    match /verification_requests/{uid} {
      allow create: if isOwner(uid);
      allow read: if isOwner(uid) || isReviewer();
      allow update: if isReviewer();
      allow delete: if false;
    }

    match /vault_documents/{docId} {
      allow read: if isSignedIn() &&
          (resource.data.ownerUserId == request.auth.uid ||
              (resource.data.allowedUserIds is list &&
                  request.auth.uid in resource.data.allowedUserIds));

      allow create: if isSignedIn() &&
          request.resource.data.ownerUserId == request.auth.uid &&
          request.resource.data.fileName is string &&
          request.resource.data.downloadUrl is string &&
          request.resource.data.storagePath is string &&
          request.resource.data.allowedUserIds is list &&
          request.auth.uid in request.resource.data.allowedUserIds;

      allow update: if isSignedIn() &&
          resource.data.ownerUserId == request.auth.uid &&
          request.resource.data.ownerUserId == resource.data.ownerUserId;

      allow delete: if isSignedIn() &&
          resource.data.ownerUserId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
